{
  "actions": {
    "other_commands": "ask",
    "network": "ask",
    "external_writes": "ask"
  },
  "rules": [
    {
      "action": "other_commands",
      "match": "ls .scratch/ .scratch/scratch-chat .scratch/board-ux 2>&1",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "ls .scratch/*",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "ls packages/core/src/work packages/core/src/flow packages/core/src/knowledge",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -n \"projectThread\\|ProjectThread\\|readOnly\\|read-only\" packages/core/src/flow/session-manager.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -rn \"PROJECT_THREAD_POLICY\\|PROJECT_THREAD_ROLE\" packages/core/src packages/widget-sdk/src",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cat packages/widget-sdk/src/project-thread.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git add .scratch/scratch-chat/grill.md",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "ls .scratch",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git ls-tree -r --name-only demo-project",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git show demo-project:.scratch/demo-project/issues/09-first-live-run-by-hand.md",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "ls -d \"$TEMP\"/kiln-scratch-repo 2>&1",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "mkdir -p .scratch/demo-project",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "ls -a .kiln 2>&1",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "mkdir .kiln",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git log --oneline -5",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "find . -path ./node_modules -prune -o -ipath '*local-first*' -print",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git status -s",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git log --oneline -3",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git log --oneline -8",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cat packages/core/src/work/workflow-validator.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cat .scratch/local-first/issues/07*.md",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git log --oneline --all -i --grep=variant",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -H \"^\\*\\*Status\" .scratch/local-first/issues/*.md",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git log --oneline -60",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cat packages/widget-sdk/src/work.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cd packages/core/src/flow",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "for b in kiln/ticket/local-first/03 kiln/ticket/local-first/07 local-first-03",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git diff --stat master local-first-03",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git log --oneline -3 -- widgets/claude-code",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -n \"THREAD_TYPES\" -A6 packages/core/src/flow/session-manager.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git branch -a",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "sed -n 195,260p packages/core/src/db.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "ls -a .kiln",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "sed -n 330,395p packages/core/src/flow/session-manager.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git diff --diff-filter=U",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -rn \"testCommand\" packages/core/src",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "sed -n 160,215p packages/widget-sdk/src/work.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cd .",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "printf '{\\n  \"testCommand\": \"npm test\"\\n}\\n' > .kiln/settings.json",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "sed -n 15,70p packages/widget-sdk/src/agent.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "python - <<'E'",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cat packages/core/src/local/routes.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -n \"configDir\\|freshConfigDir\\|<<<<\\|>>>>\\|local\" widgets/claude-code/src/agent.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "grep -n \"createSessionManager\\|createClock\\|const clock\\|stageModel:\" -B2 -A12 packages/core/src/server.ts",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "cat .kiln/settings.json",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "git add -A",
      "decision": "allow"
    },
    {
      "action": "other_commands",
      "match": "npm test 2>&1",
      "decision": "allow"
    }
  ]
}
