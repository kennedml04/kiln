{
  "name": "kiln",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "widgets/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @kiln/shell",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/check-lock.ts && node scripts/check-banned.ts",
    "test": "npm run check && npm run build && npm run typecheck && npm run test:only",
    "test:only": "node --test --test-concurrency=8 --test-timeout=300000 \"packages/*/test/**/*.test.ts\" \"widgets/*/test/**/*.test.ts\"",
    "kiln": "node packages/core/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
